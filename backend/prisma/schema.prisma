generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String
  password  String
  role      Role     @default(USER)
  status    UserStatus @default(ELIGIBLE)
  attempts  Int      @default(0)
  maxAttempts Int    @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts_data Attempt[]
  scores        Score[]
  adminActions  AdminAction[] @relation("AdminActions")
  targetActions AdminAction[] @relation("TargetUserActions")

  @@index([email])
  @@index([role])
  @@index([status])
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int      // in minutes
  maxAttempts Int      @default(3)
  passMark    Float    @default(80)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  attempts  Attempt[]

  @@index([isActive])
}

model Question {
  id       String      @id @default(uuid())
  examId   String
  content  String
  type     QuestionType
  order    Int
  points   Float       @default(10)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  exam     Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  options  Option[]
  answers  Answer[]

  @@index([examId])
  @@index([type])
}

model Option {
  id          String   @id @default(uuid())
  questionId  String
  content     String
  isCorrect   Boolean  @default(false)
  order       Int

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Attempt {
  id              String        @id @default(uuid())
  userId          String
  examId          String
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  status          AttemptStatus @default(IN_PROGRESS)
  timeSpent       Int           @default(0) // in seconds
  pasteCount      Int           @default(0)
  tabSwitchCount  Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers  Answer[]
  scores   Score[]
  plagiarismReports PlagiarismReport[]

  @@index([userId])
  @@index([examId])
  @@index([status])
}

model Answer {
  id              String   @id @default(uuid())
  attemptId       String
  questionId      String
  selectedOptionId String?
  textAnswer      String?
  wordCount       Int      @default(0)
  timeSpent       Int      @default(0) // in seconds
  wpm             Float    @default(0)
  pasteCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Score {
  id              String   @id @default(uuid())
  userId          String
  attemptId       String   @unique
  accuracy        Float    @default(0)
  grammar         Float    @default(0)
  plagiarism      Float    @default(0)
  typingSpeed     Float    @default(0)
  promptQuality   Float    @default(0)
  finalScore      Float    @default(0)
  passed          Boolean  @default(false)
  details         Json?    // Store detailed breakdown
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([attemptId])
  @@index([passed])
}

model PlagiarismReport {
  id              String   @id @default(uuid())
  attemptId       String
  answerId        String?
  similarityScore Float    @default(0)
  matchedContent  String?
  source          String?
  flagged         Boolean  @default(false)
  createdAt       DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([flagged])
}

model AdminAction {
  id          String   @id @default(uuid())
  adminId     String
  targetId    String
  actionType  String   // RESET_ATTEMPTS, REACTIVATE_USER, etc.
  description String?
  createdAt   DateTime @default(now())

  admin  User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  target User @relation("TargetUserActions", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetId])
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ELIGIBLE
  DISQUALIFIED
}

enum QuestionType {
  MCQ
  SUBJECTIVE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}
